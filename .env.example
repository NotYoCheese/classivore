# Anthropic API key (required for enrichment, labeling, and LLM queries)
ANTHROPIC_API_KEY=sk-ant-...

# Search provider keys (at least one required for collection)
# Brave is tried first, Serper on Brave failure/quota, Exa as final fallback
# (Exa also serves as a scrape fallback when live scraping is blocked).
BRAVE_API_KEY=BSA...
SERPER_API_KEY=...
EXA_API_KEY=...

# HuggingFace token (required for model publishing)
HUGGINGFACE_TOKEN=hf_...
